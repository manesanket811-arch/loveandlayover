# Terraform state files
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*.backup

# Terraform lock file (optional - commit for reproducibility)
.terraform.lock.hcl

# Terraform plan files
*.tfplan
tfplan

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH key files
*.pem
*.pub

# Local .terraform directories
**/.terraform/*

# .tfvars files (when using in local development, keep terraform.tfvars in Git)
# Uncomment if you want to exclude tfvars
# *.tfvars
# *.tfvars.json

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python related (Lambda function code)
__pycache__/
*.pyc
*.egg-info/

# Lambda zip files
lambda_function.zip
*.zip
